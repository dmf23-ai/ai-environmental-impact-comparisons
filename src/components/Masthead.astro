---
// Masthead — homepage-only hero. The dominant visual element of the site:
// a large expressive Cormorant display title, a letter-spaced subtitle with a
// true subscript on CO2, a short dek, and flanking poppy clusters + engraved
// rules in the reference's Art Nouveau grammar.
import BotanicalFrieze from "./BotanicalFrieze.astro";
interface Props { dek?: string; }
const {
  dek = "An interactive atlas of AI's environmental impact in scale, context, and comparison.",
} = Astro.props;
---

<header class="masthead">
  <hr class="hairline masthead-rule" />

  <!-- shared poppy-cluster shape, referenced by both flanks -->
  <svg width="0" height="0" aria-hidden="true" style="position:absolute">
    <defs>
      <g id="cw-poppy-cluster" transform="translate(60,150)">
        <path d="M0,0 C -6,-40 -10,-80 -4,-120" fill="none" stroke="var(--ink-soft)" stroke-width="2"/>
        <path d="M-4,-60 C -28,-66 -40,-86 -36,-104 C -22,-92 -10,-84 -2,-78 Z" fill="var(--sage)" opacity="0.85"/>
        <path d="M0,-92 C 22,-100 34,-120 30,-138 C 16,-126 4,-112 0,-104 Z" fill="var(--sage)" opacity="0.8"/>
        <g transform="translate(-4,-122)">
          <g fill="var(--terracotta)">
            <ellipse cx="0" cy="-16" rx="12" ry="17"/>
            <ellipse cx="16" cy="-3" rx="17" ry="12"/>
            <ellipse cx="-16" cy="-3" rx="17" ry="12"/>
            <ellipse cx="10" cy="13" rx="13" ry="13" opacity="0.92"/>
            <ellipse cx="-10" cy="13" rx="13" ry="13" opacity="0.92"/>
          </g>
          <circle cx="0" cy="-1" r="7" fill="#2a1c14"/>
        </g>
      </g>
    </defs>
  </svg>

  <div class="masthead-title-row">
    <svg class="masthead-poppy masthead-poppy-left" viewBox="0 0 120 160" aria-hidden="true">
      <use href="#cw-poppy-cluster" />
    </svg>

    <h1 class="masthead-title">
      <span class="site-title-main">Compared to What?</span>
      <span class="site-title-sub">AI and Water, Electricity, &amp; CO<sub>2</sub></span>
    </h1>

    <svg class="masthead-poppy masthead-poppy-right" viewBox="0 0 120 160" aria-hidden="true">
      <use href="#cw-poppy-cluster" />
    </svg>
  </div>

  <p class="masthead-dek">{dek}</p>

  <BotanicalFrieze variant="hero" class="masthead-frieze" />
</header>

<style>
  .masthead {
    text-align: center;
    margin: var(--space-6) 0 var(--space-7);
  }
  .masthead-rule { max-width: 13rem; margin: 0 auto var(--space-5); }

  .masthead-title-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-5);
  }
  .masthead-title { margin: 0; }
  .site-title-main {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(2.9rem, 8.5vw, 6.6rem);
    line-height: 0.92;
    letter-spacing: 0.01em;
    color: var(--ink);
  }
  .site-title-sub {
    display: block;
    font-family: var(--font-serif);
    font-variant-caps: small-caps;
    text-transform: lowercase;
    font-size: clamp(1rem, 2.8vw, 2rem);
    letter-spacing: 0.14em;
    color: var(--ink-soft);
    margin-top: clamp(0.4rem, 1.2vw, 0.9rem);
  }
  .site-title-sub sub {
    font-size: 0.62em;
    vertical-align: sub;
    letter-spacing: 0;
  }

  .masthead-poppy {
    width: clamp(60px, 8vw, 104px);
    height: auto;
    flex-shrink: 0;
  }
  .masthead-poppy-right { transform: scaleX(-1); }

  .masthead-dek {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.02rem, 2.2vw, 1.28rem);
    line-height: 1.5;
    color: var(--ink-soft);
    max-width: 33rem;
    margin: var(--space-4) auto var(--space-5);
  }
  .masthead-frieze { max-width: 56rem; margin: 0 auto; }

  /* Hide flanking poppies on narrow screens; the frieze carries the botanicals */
  @media (max-width: 760px) {
    .masthead-poppy { display: none; }
    .masthead-title-row { gap: 0; }
  }
</style>
