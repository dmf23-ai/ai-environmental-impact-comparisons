---
interface Figure {
  label: string;
  value?: number;
  value_low?: number;
  value_high?: number;
  confidence?: string;
}
interface Props {
  figures: Figure[];
  max?: number;
  /** Optional subject tint; defaults to the warm rust accent. */
  subject?: "water" | "electricity" | "carbon";
}
const { figures, subject } = Astro.props;

// Compute the chart's right-edge value: the largest high (or value) across all
// figures, rounded up to a clean number for a tidy axis.
function niceCeiling(n: number): number {
  if (n <= 10) return Math.ceil(n);
  const magnitude = Math.pow(10, Math.floor(Math.log10(n)));
  const mantissa = n / magnitude;
  let rounded;
  if (mantissa <= 1) rounded = 1;
  else if (mantissa <= 2) rounded = 2;
  else if (mantissa <= 2.5) rounded = 2.5;
  else if (mantissa <= 5) rounded = 5;
  else rounded = 10;
  return rounded * magnitude;
}

const rawMax = Math.max(
  ...figures.map((f) => f.value_high ?? f.value ?? 0)
);
const maxVal = Astro.props.max ?? niceCeiling(rawMax);

const fmt = (n: number) => n.toLocaleString("en-US");
const barColor = subject ? `var(--subject-${subject})` : "var(--accent)";

function formatRange(f: Figure): { label: string; low: number; high: number } {
  if (f.value !== undefined) {
    return { label: fmt(f.value), low: f.value, high: f.value };
  }
  const lo = f.value_low ?? 0;
  const hi = f.value_high ?? 0;
  return { label: `${fmt(lo)}–${fmt(hi)}`, low: lo, high: hi };
}
---

<div class="range-bars" role="img" aria-label="Comparison bars" style={`--bar-color: ${barColor}`}>
  {
    figures.map((f) => {
      const r = formatRange(f);
      const isPoint = r.low === r.high;
      const fillPct = (r.high / maxVal) * 100;
      const leftPct = (r.low / maxVal) * 100;
      const widthPct = ((r.high - r.low) / maxVal) * 100;
      return (
        <div class="bar-row">
          <div class="bar-header">
            <span class="bar-label">{f.label}</span>
            <span class="bar-value">{r.label}</span>
          </div>
          <div class="bar-track">
            {isPoint ? (
              <div class="bar-fill" style={`width: ${fillPct}%`} />
            ) : (
              <div
                class="bar-band"
                style={`left: ${leftPct}%; width: ${widthPct}%`}
              />
            )}
          </div>
        </div>
      );
    })
  }
  <div class="axis">
    <span>0</span>
    <span>{fmt(maxVal)}</span>
  </div>
</div>

<style>
  .range-bars {
    display: grid;
    gap: 1.1rem;
    margin: 1.5rem 0 0.5rem;
    /* faint laid-paper texture behind the plotting area */
    padding: 0.9rem 0.85rem 0.4rem;
    border-radius: 8px;
    background:
      repeating-linear-gradient(
        0deg,
        rgba(120, 96, 56, 0.04) 0,
        rgba(120, 96, 56, 0.04) 1px,
        transparent 1px,
        transparent 6px
      ),
      var(--paper-light);
    box-shadow: inset 0 0 0 1px var(--hairline);
  }
  .bar-row {
    display: grid;
    gap: 0.35rem;
  }
  .bar-header {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    align-items: baseline;
    font-size: 0.92rem;
  }
  .bar-label {
    color: var(--ink);
  }
  .bar-value {
    color: var(--ink);
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    white-space: nowrap;
  }
  .bar-track {
    position: relative;
    height: 20px;
    background: rgba(0, 0, 0, 0.05);
    /* capsule ends + hairline quarter gridlines */
    border-radius: 10px;
    overflow: hidden;
    box-shadow: inset 0 0 0 1px rgba(90, 70, 40, 0.12);
    background-image: linear-gradient(
      to right,
      transparent calc(25% - 0.5px), rgba(90, 70, 40, 0.1) calc(25% - 0.5px),
      rgba(90, 70, 40, 0.1) calc(25% + 0.5px), transparent calc(25% + 0.5px),
      transparent calc(50% - 0.5px), rgba(90, 70, 40, 0.1) calc(50% - 0.5px),
      rgba(90, 70, 40, 0.1) calc(50% + 0.5px), transparent calc(50% + 0.5px),
      transparent calc(75% - 0.5px), rgba(90, 70, 40, 0.1) calc(75% - 0.5px),
      rgba(90, 70, 40, 0.1) calc(75% + 0.5px), transparent calc(75% + 0.5px)
    );
  }
  .bar-fill {
    position: relative;
    height: 100%;
    background: var(--bar-color);
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px rgba(40, 28, 16, 0.3);
  }
  /* engraved point tick at the exact value (right edge of fill) */
  .bar-fill::after {
    content: "";
    position: absolute;
    top: -2px;
    bottom: -2px;
    right: 0;
    width: 2px;
    background: var(--ink);
    opacity: 0.55;
  }
  .bar-band {
    position: absolute;
    top: 0;
    height: 100%;
    background: var(--bar-color);
    opacity: 0.9;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px rgba(40, 28, 16, 0.3);
    /* hatched capsule to read as "range, not point" */
    background-image: linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.22) 25%,
      transparent 25%,
      transparent 50%,
      rgba(255, 255, 255, 0.22) 50%,
      rgba(255, 255, 255, 0.22) 75%,
      transparent 75%,
      transparent
    );
    background-size: 8px 8px;
  }
  .axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.74rem;
    letter-spacing: 0.04em;
    color: var(--ink-soft);
    font-variant-numeric: tabular-nums;
    margin-top: 0.4rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--rule);
  }
</style>
