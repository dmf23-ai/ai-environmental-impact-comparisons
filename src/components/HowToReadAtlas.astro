---
// HowToReadAtlas — the wide horizontal "legend" strip beneath the masthead.
// A major atlas legend (not a paragraph): a stacked label cell followed by
// four equal cells with small engraved icons and dotted dividers. The
// last-verified date is computed from the data so it never drifts.
import figuresData from "../data/figures.json";

const dates: string[] = [];
const fd = figuresData as any;
for (const c of fd.comparisons ?? []) if (c.last_verified) dates.push(c.last_verified);
for (const i of fd.infographics ?? []) if (i.last_verified) dates.push(i.last_verified);
if (fd.hourly_impact?.last_verified) dates.push(fd.hourly_impact.last_verified);
const latest = dates.sort().at(-1) ?? "2026-05-16";
const verified = new Date(latest + "T00:00:00Z").toLocaleDateString("en-US", {
  month: "long", day: "numeric", year: "numeric", timeZone: "UTC",
});
---

<section class="htr" aria-label="How to read this atlas">
  <div class="htr-cell htr-label">
    <span>How to read<br />this atlas</span>
  </div>

  <div class="htr-cell">
    <svg class="htr-ico" viewBox="0 0 28 20" aria-hidden="true">
      <path d="M6 3 H4 V17 H6 M22 3 H24 V17 H22" fill="none" stroke="var(--rust)" stroke-width="1.6" stroke-linecap="round"/>
      <rect x="8" y="8.5" width="12" height="3" rx="1.5" fill="var(--teal)"/>
      <line x1="14" y1="6" x2="14" y2="14" stroke="var(--ink)" stroke-width="1.4"/>
    </svg>
    <p>Most numbers are <strong>ranges</strong>, not single values.</p>
  </div>

  <div class="htr-cell">
    <svg class="htr-ico" viewBox="0 0 24 20" aria-hidden="true">
      <circle cx="12" cy="10" r="7.5" fill="none" stroke="var(--rust)" stroke-width="1.5"/>
      <path d="M12 4 v12 M6 10 h12" stroke="var(--rust)" stroke-width="1.5"/>
    </svg>
    <p><strong>Boundary choices</strong> change the answer.</p>
  </div>

  <div class="htr-cell">
    <svg class="htr-ico" viewBox="0 0 26 20" aria-hidden="true">
      <path d="M13 5 C10 3 6 3 3 4 V16 C6 15 10 15 13 17 C16 15 20 15 23 16 V4 C20 3 16 3 13 5 Z"
        fill="none" stroke="var(--teal)" stroke-width="1.4" stroke-linejoin="round"/>
      <line x1="13" y1="5" x2="13" y2="17" stroke="var(--teal)" stroke-width="1.2"/>
    </svg>
    <p><strong>Sources &amp; methods</strong> are linked on every plate.</p>
  </div>

  <div class="htr-cell htr-verified">
    <svg class="htr-ico" viewBox="0 0 22 20" aria-hidden="true">
      <circle cx="9" cy="9" r="6.5" fill="none" stroke="var(--ink-soft)" stroke-width="1.5"/>
      <path d="M9 5.5 V9 L11.5 10.5" fill="none" stroke="var(--ink-soft)" stroke-width="1.4" stroke-linecap="round"/>
      <line x1="13.6" y1="13.6" x2="18" y2="18" stroke="var(--ink-soft)" stroke-width="1.8" stroke-linecap="round"/>
    </svg>
    <p>Last verified<br /><strong>{verified}</strong></p>
  </div>
</section>

<style>
  .htr {
    display: grid;
    grid-template-columns: auto repeat(4, 1fr);
    align-items: stretch;
    gap: 0;
    margin: var(--space-5) auto var(--space-6);
    border: 1px solid var(--rule-strong);
    border-radius: 14px;
    background: linear-gradient(rgba(251, 245, 232, 0.6), rgba(244, 234, 214, 0.55));
    box-shadow: inset 0 0 0 4px rgba(255, 255, 255, 0.25);
    overflow: hidden;
  }
  .htr-cell {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.7rem 1.05rem;
    min-height: 76px;
  }
  .htr-cell + .htr-cell {
    border-left: 1px dotted rgba(112, 96, 62, 0.55);
  }
  .htr-cell p {
    margin: 0;
    font-family: var(--font-serif);
    font-size: 0.92rem;
    line-height: 1.32;
    color: var(--ink-soft);
  }
  .htr-cell p strong { color: var(--ink); font-weight: 700; }
  .htr-ico { width: 26px; height: 20px; flex-shrink: 0; }

  .htr-label {
    background: rgba(112, 96, 62, 0.08);
  }
  .htr-label span {
    font-family: var(--font-serif);
    font-variant-caps: small-caps;
    text-transform: lowercase;
    letter-spacing: 0.08em;
    font-size: 1.02rem;
    font-weight: 700;
    color: var(--ink);
    line-height: 1.15;
  }
  .htr-verified p { font-size: 0.86rem; }

  @media (max-width: 880px) {
    .htr {
      grid-template-columns: 1fr 1fr;
    }
    .htr-label { grid-column: 1 / -1; justify-content: center; text-align: center; }
    .htr-cell { min-height: 64px; }
    /* reset borders for the 2-col wrap */
    .htr-cell + .htr-cell { border-left: 1px dotted rgba(112, 96, 62, 0.4); }
    .htr-cell:nth-child(even) { border-left: none; }
    .htr-cell:not(.htr-label) { border-top: 1px dotted rgba(112, 96, 62, 0.4); }
  }
  @media (max-width: 520px) {
    .htr { grid-template-columns: 1fr; }
    .htr-cell + .htr-cell { border-left: none; border-top: 1px dotted rgba(112, 96, 62, 0.4); }
  }
</style>
