---
// PlateIllustration — small engraved-style line icon for an atlas plate.
// Drawn in currentColor (line art, restrained) so the card tints it to the
// plate's subject hue. Decorative: marked aria-hidden; the card carries the
// text label that conveys meaning.
interface Props { name: string; size?: number; }
const { name, size = 40 } = Astro.props;
const sw = 2;
---
<svg class="plate-illo" width={size} height={size} viewBox="0 0 48 48"
     fill="none" stroke="currentColor" stroke-width={sw}
     stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === "golf" && (<g>
    <path d="M10 36 q14 -6 28 0" />
    <line x1="20" y1="14" x2="20" y2="33" />
    <path d="M20 14 l9 3 -9 3 z" fill="currentColor" stroke="none" />
    <circle cx="20" cy="34" r="1.6" fill="currentColor" stroke="none" />
    <path d="M30 33 q4 1 6 3" /><path d="M12 33 q-2 1 -3 3" />
  </g>)}
  {name === "sprinkler" && (<g>
    <line x1="24" y1="28" x2="24" y2="40" /><line x1="16" y1="40" x2="32" y2="40" />
    <path d="M24 26 q-9 -2 -13 4" /><path d="M24 26 q9 -2 13 4" /><path d="M24 24 v-6" />
    <circle cx="11" cy="22" r="1.2" fill="currentColor" stroke="none" />
    <circle cx="37" cy="22" r="1.2" fill="currentColor" stroke="none" />
    <circle cx="24" cy="16" r="1.2" fill="currentColor" stroke="none" />
  </g>)}
  {name === "car" && (<g>
    <path d="M8 30 l3 -8 h18 l6 6 h5 v8" /><line x1="8" y1="30" x2="42" y2="30" />
    <circle cx="16" cy="32" r="3.2" /><circle cx="33" cy="32" r="3.2" />
    <line x1="18" y1="22" x2="18" y2="28" />
  </g>)}
  {name === "house" && (<g>
    <path d="M10 24 l14 -11 14 11" /><path d="M14 24 v14 h20 v-14" />
    <rect x="21" y="30" width="6" height="8" />
  </g>)}
  {name === "plane" && (<g>
    <path d="M24 8 c2 0 3 3 3 7 l10 8 v3 l-10 -3 v7 l3 3 v2 l-6 -2 -6 2 v-2 l3 -3 v-7 l-10 3 v-3 l10 -8 c0 -4 1 -7 3 -7 z" fill="currentColor" stroke="none" />
  </g>)}
  {name === "factory" && (<g>
    <path d="M10 38 v-12 l8 5 v-5 l8 5 v-5 l8 5 v12 z" />
    <line x1="14" y1="22" x2="14" y2="14" /><line x1="14" y1="14" x2="18" y2="14" />
    <path d="M30 18 q3 -3 0 -6" />
  </g>)}
  {name === "bitcoin" && (<g>
    <circle cx="24" cy="24" r="13" />
    <path d="M21 17 v14 M25 17 v14 M19 20 h8 a3 3 0 0 1 0 6 h-8 M19 26 h9 a3 3 0 0 1 0 6 h-9" stroke-width="1.7" />
  </g>)}
  {name === "ev" && (<g>
    <rect x="12" y="16" width="12" height="20" rx="2" /><line x1="12" y1="22" x2="24" y2="22" />
    <path d="M30 18 l-4 8 h4 l-4 8" stroke-width="2.2" />
  </g>)}
  {name === "streaming" && (<g>
    <rect x="9" y="13" width="30" height="20" rx="2" /><line x1="18" y1="38" x2="30" y2="38" />
    <path d="M21 19 l8 4 -8 4 z" fill="currentColor" stroke="none" />
  </g>)}
  {name === "controller" && (<g>
    <path d="M16 20 h16 a8 8 0 0 1 7 12 q-2 4 -6 1 l-3 -3 h-12 l-3 3 q-4 3 -6 -1 a8 8 0 0 1 7 -12 z" />
    <line x1="17" y1="26" x2="23" y2="26" /><line x1="20" y1="23" x2="20" y2="29" />
    <circle cx="31" cy="25" r="1.3" fill="currentColor" stroke="none" /><circle cx="34" cy="28" r="1.3" fill="currentColor" stroke="none" />
  </g>)}
  {name === "cattle" && (<g>
    <path d="M14 20 q-4 -6 -8 -4 q3 3 4 6" /><path d="M34 20 q4 -6 8 -4 q-3 3 -4 6" />
    <path d="M14 20 h20 v8 a4 4 0 0 1 -4 4 h-12 a4 4 0 0 1 -4 -4 z" />
    <line x1="19" y1="32" x2="19" y2="38" /><line x1="29" y1="32" x2="29" y2="38" />
    <circle cx="19" cy="24" r="1.1" fill="currentColor" stroke="none" /><circle cx="29" cy="24" r="1.1" fill="currentColor" stroke="none" />
  </g>)}
  {name === "ac" && (<g>
    <rect x="9" y="15" width="30" height="14" rx="2" /><line x1="9" y1="24" x2="39" y2="24" />
    <path d="M16 33 q2 2 0 4" /><path d="M24 33 q2 2 0 4" /><path d="M32 33 q2 2 0 4" />
  </g>)}
  {name === "mower" && (<g>
    <path d="M9 32 h16 l2 -6 h6" /><path d="M31 26 l8 -8" /><line x1="9" y1="32" x2="9" y2="26" />
    <circle cx="14" cy="35" r="3" /><circle cx="24" cy="35" r="2.4" />
  </g>)}
  {name === "lights" && (<g>
    <path d="M8 16 q8 8 16 0 t16 0" />
    <path d="M12 19 v3 M20 23 v3 M28 23 v3 M36 19 v3" />
    <circle cx="12" cy="24" r="2" fill="currentColor" stroke="none" /><circle cx="20" cy="28" r="2" fill="currentColor" stroke="none" />
    <circle cx="28" cy="28" r="2" fill="currentColor" stroke="none" /><circle cx="36" cy="24" r="2" fill="currentColor" stroke="none" />
  </g>)}
  {name === "clock" && (<g>
    <circle cx="24" cy="24" r="13" /><path d="M24 16 v8 l6 4" />
  </g>)}
</svg>
<style>
  .plate-illo { display: block; }
</style>
