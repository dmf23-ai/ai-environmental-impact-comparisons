---
// TopNav — persistent primary navigation for every page (lives in Layout).
// Balanced small-caps groups flank a center wordmark with engraved rules
// extending toward it, as in Mockup 1:
//   ABOUT · COMPARISONS  —  COMPARED TO WHAT?  —  METHODS · SOURCES  [GitHub]
const repo = "https://github.com/dmf23-ai/ai-environmental-impact-comparisons";
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path === href || path.startsWith(href + "/");
---

<nav class="topnav" aria-label="Primary">
  <ul class="topnav-group topnav-left">
    <li><a href="/about" aria-current={isActive("/about") ? "page" : undefined}>About</a></li>
    <li><a href="/comparisons" aria-current={isActive("/comparisons") ? "page" : undefined}>Comparisons</a></li>
  </ul>

  <div class="topnav-center">
    <span class="topnav-rule" aria-hidden="true"></span>
    <a href="/" class="topnav-wordmark" aria-label="Compared to What? — home">
      Compared to What?
    </a>
    <span class="topnav-rule" aria-hidden="true"></span>
  </div>

  <ul class="topnav-group topnav-right">
    <li><a href="/methods" aria-current={isActive("/methods") ? "page" : undefined}>Methods</a></li>
    <li><a href="/methods#sources">Sources</a></li>
    <li>
      <a class="topnav-gh" href={repo} target="_blank" rel="noopener noreferrer" aria-label="Source code on GitHub">
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" focusable="false">
          <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8 8 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>
        </svg>
      </a>
    </li>
  </ul>
</nav>

<style>
  .topnav {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: var(--space-4);
    max-width: 66rem;
    margin: 0 auto;
    padding: 0 var(--space-4);
  }
  .topnav-group {
    display: flex;
    align-items: center;
    gap: 0;
    list-style: none;
    margin: 0;
    padding: 0;
    font-family: var(--font-serif);
    font-variant-caps: small-caps;
    letter-spacing: 0.12em;
    font-size: 0.86rem;
  }
  .topnav-left { justify-content: flex-end; }
  .topnav-right { justify-content: flex-start; }
  .topnav-group li { display: inline-flex; align-items: center; }
  /* Diamond separators between items within a group */
  .topnav-group li + li::before {
    content: "\2666";
    color: var(--accent);
    font-size: 0.5em;
    margin: 0 0.7em;
    transform: translateY(-0.15em);
    font-variant-caps: normal;
  }
  .topnav-group a {
    color: var(--ink-soft);
    text-decoration: none;
    white-space: nowrap;
    transition: color 140ms ease;
  }
  .topnav-group a:hover { color: var(--accent); }
  .topnav-group a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--accent);
    text-underline-offset: 4px;
  }
  .topnav-gh {
    display: inline-flex;
    align-items: center;
    color: var(--ink-soft);
  }
  .topnav-gh:hover { color: var(--accent); }

  /* Center wordmark with engraved rules extending toward it */
  .topnav-center {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    justify-content: center;
  }
  .topnav-rule {
    display: block;
    width: clamp(1.4rem, 4vw, 3.2rem);
    height: 1px;
    background: linear-gradient(to var(--_dir, right), transparent, var(--rule-strong));
    flex-shrink: 0;
  }
  .topnav-center .topnav-rule:last-child { --_dir: left; }
  .topnav-wordmark {
    font-family: var(--font-serif);
    font-variant-caps: small-caps;
    letter-spacing: 0.14em;
    font-size: 0.94rem;
    color: var(--ink);
    text-decoration: none;
    white-space: nowrap;
    text-align: center;
  }
  .topnav-wordmark:hover { color: var(--accent); }

  /* Mobile: drop the center wordmark + rules, keep the two groups balanced */
  @media (max-width: 640px) {
    .topnav {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2);
      padding: 0 var(--space-3);
    }
    .topnav-center { display: none; }
    .topnav-group { font-size: 0.78rem; letter-spacing: 0.08em; }
    .topnav-group li + li::before { margin: 0 0.5em; }
  }
</style>
