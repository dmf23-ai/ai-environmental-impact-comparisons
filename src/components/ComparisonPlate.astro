---
// ComparisonPlate — an illustrated specimen card for the atlas. A circular
// plate-number medallion, a generated spot illustration that identifies the
// topic, metric/scope chips, title, one short italic takeaway, and a mini
// engraved chart. The whole plate is an OrnatePopupTrigger that blooms open
// the full detail (chart + sources + method) on click/Enter.
import OrganicFrame from "./OrganicFrame.astro";
import OrnatePopupTrigger from "./OrnatePopupTrigger.astro";
import RangeBar from "./RangeBar.astro";
import {
  metricLabel, scopeLabel, confidenceLabel, subjectForMetric,
  type Metric, type Scope, type Confidence,
} from "../lib/atlasMeta";
import { spotByIllustration, spotAltByIllustration } from "../lib/redesignAssets";

interface Figure { label: string; value?: number; value_low?: number; value_high?: number; confidence?: string; }
interface Props {
  plate: number;
  title: string;
  metric: Metric;
  scope: Scope;
  confidence: Confidence;
  boundarySensitive?: boolean;
  illustration: string;
  takeaway: string;
  figures: Figure[];
  popupId: string;
}
const { plate, title, metric, scope, confidence, boundarySensitive = false,
  illustration, takeaway, figures, popupId } = Astro.props;
const subject = subjectForMetric(metric);
const num = String(plate).padStart(2, "0");
const spot = spotByIllustration[illustration];
const spotAlt = spotAltByIllustration[illustration] ?? "";
---

<OrnatePopupTrigger popupId={popupId} as="card" label={`Open detail for ${title}`}>
  <OrganicFrame subject={subject}>
    <article class="plate" data-subject={subject}>
      <div class="plate-body">
        <div class="plate-illo">
          {spot && <img src={spot} alt={spotAlt} loading="lazy" decoding="async" width="120" height="120" />}
          <span class="plate-num">{num}</span>
        </div>

        <div class="plate-head">
          <span class="plate-chips">
            <span class="plate-chip">{metricLabel[metric]}</span>
            <span class="plate-dot">·</span>
            <span class="plate-chip">{scopeLabel[scope]}</span>
            {boundarySensitive && (
              <svg class="plate-seal" viewBox="0 0 18 18" aria-label="Boundary-sensitive">
                <circle cx="9" cy="9" r="7.5" fill="none" stroke="var(--accent)" stroke-width="1.3"/>
                <path d="M9 4.5 v9 M4.5 9 h9" stroke="var(--accent)" stroke-width="1.3"/>
              </svg>
            )}
          </span>
          <h3 class="plate-title">{title}</h3>
          <p class="plate-take">{takeaway}</p>
        </div>
      </div>

      <div class="plate-mini">
        <RangeBar figures={figures} />
      </div>

      <footer class="plate-foot">
        <span class="plate-conf">{confidenceLabel[confidence]}</span>
        <span class="plate-open">Open detail →</span>
      </footer>
    </article>
  </OrganicFrame>
</OrnatePopupTrigger>

<style>
  :global(.ornate-popup-trigger-card > .organic-frame) { margin: 0; height: 100%; }
  .plate {
    display: flex;
    flex-direction: column;
    height: 100%;
    text-align: left;
    gap: var(--space-2);
  }
  .plate-body {
    display: flex;
    align-items: flex-start;
    gap: var(--space-3);
  }
  /* Spot illustration with a plate-number medallion badge */
  .plate-illo {
    position: relative;
    flex-shrink: 0;
    width: clamp(58px, 22%, 78px);
    aspect-ratio: 1;
    border-radius: 12px;
    overflow: hidden;
    border: 1px solid var(--hairline);
    background: var(--paper-light);
    box-shadow: inset 0 0 0 3px rgba(255, 255, 255, 0.28);
  }
  .plate-illo img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .plate-num {
    position: absolute;
    top: -7px;
    left: -7px;
    width: 1.55rem;
    height: 1.55rem;
    border-radius: 50%;
    background: var(--paper-light);
    border: 1.5px solid var(--accent);
    color: var(--accent);
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.86rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 1px 3px rgba(50, 37, 20, 0.18);
  }
  .plate-head { min-width: 0; flex: 1; }
  .plate-chips {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    font-family: var(--font-serif);
    font-variant-caps: small-caps;
    letter-spacing: 0.06em;
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
  .plate-dot { color: var(--accent); }
  .plate-seal { width: 14px; height: 14px; margin-left: 0.15em; }
  .plate-title {
    font-family: var(--font-serif);
    font-weight: 700;
    font-size: 1.02rem;
    line-height: 1.22;
    color: var(--ink);
    margin: 0.2rem 0 0;
  }
  .plate-take {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.9rem;
    line-height: 1.4;
    color: var(--ink-soft);
    margin: 0.25rem 0 0;
  }
  .plate-mini {
    margin-top: auto;
    padding-top: var(--space-3);
  }
  /* compact the shared RangeBar inside a dense card */
  .plate-mini :global(.range-bars) { gap: 0.55rem; margin: 0.4rem 0 0; }
  .plate-mini :global(.bar-header) { font-size: 0.74rem; }
  .plate-mini :global(.bar-track) { height: 11px; }
  .plate-mini :global(.axis) { font-size: 0.66rem; }
  .plate-foot {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-2);
    margin-top: var(--space-3);
    padding-top: var(--space-2);
    border-top: 1px solid var(--hairline);
  }
  .plate-conf {
    font-family: var(--font-sans);
    font-size: 0.66rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .plate-open {
    font-family: var(--font-sans);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
    white-space: nowrap;
  }
</style>
