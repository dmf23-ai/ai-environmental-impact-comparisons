---
import Layout from "../layouts/Layout.astro";
import Masthead from "../components/Masthead.astro";
import RangeKey from "../components/RangeKey.astro";
import FeaturedComparisonPlate from "../components/FeaturedComparisonPlate.astro";
import ComparisonPlate from "../components/ComparisonPlate.astro";
import AtlasFilters from "../components/AtlasFilters.astro";
import OrnatePopupContent from "../components/OrnatePopupContent.astro";
import RangeBar from "../components/RangeBar.astro";
import SourceLine from "../components/SourceLine.astro";
import BotanicalFrieze from "../components/BotanicalFrieze.astro";

import InfographicAnnualTwh from "../components/InfographicAnnualTwh.astro";
import InfographicWaterBracket from "../components/InfographicWaterBracket.astro";
import InfographicDcTrajectory from "../components/InfographicDcTrajectory.astro";
import InfographicAiShareTrajectory from "../components/InfographicAiShareTrajectory.astro";
import InfographicHouseholdEquivalents from "../components/InfographicHouseholdEquivalents.astro";
import InfographicWattScalePrimer from "../components/InfographicWattScalePrimer.astro";
import InfographicTrainingVsInference from "../components/InfographicTrainingVsInference.astro";
import InfographicRangeVsPoint from "../components/InfographicRangeVsPoint.astro";
import OrganicFrame from "../components/OrganicFrame.astro";

import figuresData from "../data/figures.json";
import { atlasOrder, byId } from "../lib/atlasMeta";

const title = "Compared to What? — AI and Water, Electricity, & CO₂";
const description =
  "An interactive atlas comparing AI and data centers with familiar uses of water and electricity — homes, roads, golf courses, cattle, aviation, Bitcoin, streaming, cement, and the grid. Every figure sourced, every boundary stated.";

const comparisons = (figuresData as any).comparisons as any[];
const cmpById: Record<string, any> = Object.fromEntries(comparisons.map((c) => [c.id, c]));
const hourlyRaw = (figuresData as any).hourly_impact;

// synthetic "hourly" comparison so the home page can carry it as plate 15
const hourly = {
  id: "hourly",
  anchor: "hourly-hero",
  title: "CO₂ per hour: driving vs. AI, gaming & streaming",
  unit_caption: "Grams CO₂ per hour",
  figures: hourlyRaw.figures,
  summary: hourlyRaw.summary,
  sources: hourlyRaw.sources,
  last_verified: hourlyRaw.last_verified,
};
function record(id: string) { return id === "hourly" ? hourly : cmpById[id]; }

function spreadOf(figs: any[]): number {
  const vals: number[] = [];
  for (const f of figs) {
    for (const v of [f.value, f.value_low, f.value_high]) {
      if (typeof v === "number" && v > 0) vals.push(v);
    }
  }
  if (vals.length < 2) return 1;
  return Math.max(...vals) / Math.min(...vals);
}

const gridEntries = atlasOrder.filter((e) => !e.featured);
const featured = byId["water-dc-vs-golf"];
const featuredRec = record(featured.id);
const popupId = (id: string) => `atlas-${id}`;
---

<Layout title={title} description={description} wide>
  <Masthead />

  <section class="hero-thesis">
    <p>
      AI's environmental footprint is real, growing, and often described without
      enough scale. This atlas sets AI and data centers beside familiar systems —
      homes, roads, golf courses, cattle, aviation, Bitcoin, streaming, gaming,
      cement, steel, and the electric grid itself.
    </p>
    <p class="hero-thesis-q">
      The question is not only “How large is AI's footprint?” but
      <em>compared to what?</em>
    </p>
  </section>

  <RangeKey />

  <FeaturedComparisonPlate
    popupId={popupId(featured.id)}
    title="Water: Data Centers vs. Golf Courses"
    boundaryNote="Direct cooling alone makes data centers look tiny. Count the water used to generate their electricity and they rise beside U.S. golf — the boundary is most of the argument."
    figures={featuredRec.figures}
    statValue="500–700"
    statUnit="billion gallons / yr"
    statCaption="Global data centers, counting power plants"
  />

  <section class="atlas" aria-labelledby="atlas-heading">
    <header class="atlas-head">
      <p class="atlas-eyebrow eyebrow">The atlas</p>
      <h2 id="atlas-heading" class="atlas-title">The Atlas of Comparisons</h2>
      <p class="atlas-sub">
        Open a plate to see the numbers, assumptions, boundaries, uncertainty,
        and sources behind each comparison.
      </p>
    </header>

    <AtlasFilters />

    <div class="atlas-grid">
      {gridEntries.map((e) => {
        const c = record(e.id);
        return (
          <div
            class="plate-cell"
            data-order={e.plate}
            data-metric={e.metric}
            data-scope={e.scope}
            data-boundary={e.boundarySensitive ? "true" : "false"}
            data-confidence={e.confidence}
            data-spread={spreadOf(c.figures).toFixed(2)}
            data-title={c.title}
          >
            <ComparisonPlate
              plate={e.plate}
              title={c.title}
              metric={e.metric}
              scope={e.scope}
              confidence={e.confidence}
              boundarySensitive={e.boundarySensitive}
              illustration={e.illustration}
              takeaway={e.takeaway}
              figures={c.figures}
              popupId={popupId(e.id)}
            />
          </div>
        );
      })}
    </div>
    <p id="atlas-empty" class="atlas-empty" style="display:none">No plates match that filter.</p>

    <p class="atlas-allcta">
      <a href="/comparisons">View all comparisons →</a>
    </p>
  </section>

  <section class="fieldnotes" aria-labelledby="fieldnotes-heading">
    <BotanicalFrieze variant="small" class="fn-frieze" />
    <header class="atlas-head">
      <p class="atlas-eyebrow eyebrow">Supporting material</p>
      <h2 id="fieldnotes-heading" class="atlas-title">Field Notes on Scale</h2>
      <p class="atlas-sub">Short lessons on how to read the comparisons — the year, the water, the trajectory, the translations.</p>
    </header>

    <div class="fn-stack">
      <OrganicFrame subject="electricity"><InfographicAnnualTwh /></OrganicFrame>
      <OrganicFrame subject="water"><InfographicWaterBracket /></OrganicFrame>
      <OrganicFrame subject="electricity"><InfographicDcTrajectory /></OrganicFrame>
      <OrganicFrame subject="electricity"><InfographicAiShareTrajectory /></OrganicFrame>
      <OrganicFrame subject="electricity"><InfographicWattScalePrimer /></OrganicFrame>
      <OrganicFrame subject="electricity"><InfographicHouseholdEquivalents /></OrganicFrame>
      <OrganicFrame subject="carbon"><InfographicTrainingVsInference /></OrganicFrame>
      <OrganicFrame subject="electricity"><InfographicRangeVsPoint /></OrganicFrame>
    </div>
  </section>

  <section class="methods-cta">
    <p class="methods-cta-line">
      Read the ledger: every figure has a derivation, a source trail, an
      uncertainty note, and a last-verified date.
    </p>
    <p class="methods-cta-link"><a href="/methods">Read the methodology →</a></p>
  </section>

  {/* ===== detail popups, one per atlas plate ===== */}
  {atlasOrder.map((e) => {
    const c = record(e.id);
    return (
      <OrnatePopupContent popupId={popupId(e.id)}>
        <p class="popup-kicker">Comparison</p>
        <h2 id={`popup-title-atlas-${e.id}`}>{c.title}</h2>
        <p>{c.summary}</p>
        {e.boundarySensitive && (
          <p class="popup-boundary"><strong>Boundary note:</strong> the answer depends on where you draw the line — whether only direct use is counted, or the upstream water and power are included too.</p>
        )}
        {c.unit_caption && <p class="popup-unit">{c.unit_caption}</p>}
        <RangeBar figures={c.figures} />
        <SourceLine sources={c.sources} lastVerified={c.last_verified} methodsAnchor={c.anchor} />
      </OrnatePopupContent>
    );
  })}
</Layout>

<style>
  .hero-thesis {
    max-width: 36rem;
    margin: 0 auto var(--space-5);
    text-align: center;
  }
  .hero-thesis p {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.6;
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }
  .hero-thesis-q { font-size: 1.18rem !important; }
  .hero-thesis-q em { font-style: italic; color: var(--accent); }

  .atlas-head { text-align: center; margin: 0 0 var(--space-5); }
  .atlas-eyebrow { margin: 0 0 var(--space-2); }
  .atlas-title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.9rem, 4.5vw, 2.8rem);
    line-height: 1.05;
    color: var(--ink);
    margin: 0 0 var(--space-3);
  }
  .atlas-sub {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.02rem;
    color: var(--ink-soft);
    max-width: 32rem;
    margin: 0 auto;
    line-height: 1.5;
  }
  .atlas { margin: var(--space-8) 0 0; }
  .atlas-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
  }
  @media (min-width: 560px) {
    .atlas-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (min-width: 900px) {
    .atlas-grid { grid-template-columns: 1fr 1fr 1fr; gap: var(--space-5); }
  }
  .plate-cell { display: flex; }
  .plate-cell > :global(*) { width: 100%; }
  .atlas-empty {
    text-align: center;
    font-style: italic;
    color: var(--ink-soft);
    margin: var(--space-6) 0;
  }
  .atlas-allcta { text-align: center; margin: var(--space-7) 0 0; }
  .atlas-allcta a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  .atlas-allcta a:hover { color: var(--ink); }

  .fieldnotes { margin: var(--space-9) 0 0; }
  .fn-frieze { max-width: 34rem; margin: 0 auto var(--space-6); }
  .fn-stack { display: grid; gap: var(--space-5); max-width: 40rem; margin: 0 auto; }

  .methods-cta { text-align: center; margin: var(--space-9) auto 0; max-width: 32rem; }
  .methods-cta-line {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 1.08rem;
    color: var(--ink);
    line-height: 1.55;
    margin: 0 0 var(--space-3);
  }
  .methods-cta-link a {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 2px;
  }
  :global(.popup-boundary) {
    font-size: 0.95rem !important;
    background: rgba(154, 79, 48, 0.07);
    border-left: 2px solid var(--accent);
    padding: var(--space-2) var(--space-3);
    margin: var(--space-3) 0 !important;
  }
  :global(.popup-unit) {
    font-family: var(--font-serif);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    color: var(--ink-soft);
    margin: var(--space-3) 0 var(--space-1) !important;
  }
</style>
